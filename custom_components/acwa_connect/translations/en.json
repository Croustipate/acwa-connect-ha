{
  "config": {
    "step": {
      "user": {
        "title": "ACWA Connect",
        "description": "Capture the ACWA app's traffic with Proxyman. Paste the Bearer token (valid 24h) and the Google refresh token (permanent, for automatic renewal) here.\n\n{help}",
        "data": {
          "access_token": "ACWA Bearer token (access token)",
          "google_refresh_token": "Google refresh token (1//034... — automatic renewal)"
        }
      },
      "pick_pool": {
        "title": "Choose a pool",
        "data": {
          "pool": "Pool"
        }
      },
      "reauth_confirm": {
        "title": "Renew the ACWA Connect token",
        "description": "The access token has expired. Capture a new token from the app. Leave the Google refresh token empty to keep the one already stored.",
        "data": {
          "access_token": "New Bearer token",
          "google_refresh_token": "New Google refresh token (optional)"
        }
      }
    },
    "error": {
      "invalid_auth": "Invalid or expired token.",
      "cannot_connect": "Unable to connect to the ACWA Connect API.",
      "unknown": "Unexpected error."
    },
    "abort": {
      "already_configured": "This pool is already configured.",
      "reauth_successful": "Token renewed successfully."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "ACWA Connect options",
        "description": "Device ID of the e.Box relay module used for the light, the robot, and pH priming (MQTT). It appears in the `DEVICE_ID/CTX/DATA/...` topics (see tools/mqtt_diff.py in the README). Leave empty to disable these commands.",
        "data": {
          "mqtt_device_id": "Relay module device ID"
        }
      }
    }
  },
